# No environment file is required to render this foundation.
# Public application origin; set to the verified origin when publishing later.
JOBFRAY_PUBLIC_ORIGIN=http://localhost:3000
# Only needed for Prisma CLI validation/generation in this foundation.
# Use an isolated local database target; never paste production credentials here.
DATABASE_URL=postgresql://isolated:isolated@127.0.0.1:9/jobfray_isolated
