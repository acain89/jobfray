# No environment file is required to render this foundation.
# Public application origin; set to the verified origin when publishing later.
JOBFRAY_PUBLIC_ORIGIN=http://localhost:3000
# Only needed for Prisma CLI validation/generation in this foundation.
# Use an isolated local database target; never paste production credentials here.
DATABASE_URL=postgresql://isolated:isolated@127.0.0.1:9/jobfray_isolated

# Production configuration is intentionally disabled by default.
# Required only after independent persistence/provider release verification:
# JOBFRAY_DATABASE_ENABLED=1
# JOBFRAY_RELEASE_DB_VERIFIED=1
# JOBFRAY_CONFIRMATION_KEY=<generate and store a random secret, never use a placeholder>
# JOBFRAY_CONFIRMATION_KEY_VERSION=v1
# JOBFRAY_CONFIRMATION_PREVIOUS_KEYS=<protected JSON mapping of retained old versions>
# JOBFRAY_WORKER_KEY=<separate random secret for the maintenance scheduler>
# JOBFRAY_ADMIN_EMAILS=<normalized verified administrator emails>
# JOBFRAY_BASE_HOST=jobfray.com
# Test-only sandbox flags must never be deployed. See docs/OPERATIONS.md.

# Customer checkout uses browser-bound capabilities and phone self-confirmation.
# No customer contact-provider credentials are required.

# Only required when production providers are explicitly enabled; server only.
# GEOCODIO_API_KEY=<dedicated JobFray Geocodio key; never reuse RF/RFL credentials>
