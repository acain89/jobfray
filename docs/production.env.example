# PLACEHOLDERS ONLY. Never use this file unchanged.
NODE_ENV=production
DATABASE_URL=PLACEHOLDER_APPLICATION_DATABASE_URL
JOBFRAY_DATABASE_ENABLED=0
JOBFRAY_RELEASE_DB_VERIFIED=0
JOBFRAY_PRODUCTION_PROVIDERS=0
JOBFRAY_PROVIDER_OPERATIONS_ENABLED=0
JOBFRAY_RELEASE_PROVIDERS_VERIFIED=0
JOBFRAY_CHECKOUT_ENABLED=0
JOBFRAY_PUBLIC_INDEXING_ENABLED=0
JOBFRAY_PROVIDER_ENV=staging
JOBFRAY_SANDBOX=0
JOBFRAY_LOCAL_TEST=0
# Keep read_only until separately accepted nonfinancial or financial processing.
# financial reconciles existing payments and expired holds while Checkout stays off.
JOBFRAY_WORKER_MODE=read_only
JOBFRAY_REFUND_PROCESSING_ENABLED=0
JOBFRAY_PUBLIC_ORIGIN=https://PLACEHOLDER_CANONICAL_HOST
JOBFRAY_BASE_HOST=PLACEHOLDER_CANONICAL_HOST
JOBFRAY_CONFIRMATION_KEY=PLACEHOLDER_RANDOM_CONFIRMATION_SECRET
JOBFRAY_CONFIRMATION_KEY_VERSION=v1
JOBFRAY_CONFIRMATION_PREVIOUS_KEYS={}
JOBFRAY_ADMIN_EMAILS=PLACEHOLDER_VERIFIED_ADMIN_EMAILS
JOBFRAY_WORKER_KEY=PLACEHOLDER_RANDOM_WORKER_SECRET
# Required for global production ingress, except read-only /api/health.
# Copy only into the dedicated Cloudflare Worker secret binding; never expose publicly.
JOBFRAY_EDGE_SECRET=PLACEHOLDER_RANDOM_INGRESS_SECRET
STRIPE_SECRET_KEY=PLACEHOLDER_STRIPE_SERVER_KEY
STRIPE_ACCOUNT_ID=PLACEHOLDER_STRIPE_PLATFORM_ACCOUNT
STRIPE_WEBHOOK_SECRETS=PLACEHOLDER_STRIPE_WEBHOOK_SECRETS
STRIPE_INTEGRATION_IDENTIFIER=PLACEHOLDER_STRIPE_INTEGRATION_ID
RESEND_API_KEY=PLACEHOLDER_RESEND_KEY
JOBFRAY_EMAIL_FROM=PLACEHOLDER_AUTHENTICATED_SENDER
GEOCODIO_API_KEY=PLACEHOLDER_DEDICATED_GEOCODIO_SERVER_KEY
CLOUDINARY_CLOUD_NAME=PLACEHOLDER_DEDICATED_CLOUD
CLOUDINARY_API_KEY=PLACEHOLDER_CLOUDINARY_KEY
CLOUDINARY_API_SECRET=PLACEHOLDER_CLOUDINARY_SECRET
# Omit all optional push keys unless enabling verified device push.
# VAPID_PUBLIC_KEY=PLACEHOLDER_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=PLACEHOLDER_VAPID_PRIVATE_KEY
# VAPID_SUBJECT=PLACEHOLDER_OPERATOR_CONTACT
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=PLACEHOLDER_MATCHING_PUBLIC_KEY
NEXT_TELEMETRY_DISABLED=1
