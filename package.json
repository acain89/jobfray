{
  "name": "jobfray",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --import tsx --test tests/domain.test.ts tests/schema-compatibility.test.ts",
    "schema:validate": "prisma validate",
    "schema:proposal": "prisma validate --schema prisma/proposals/rebuild.prisma",
    "db:generate": "prisma generate",
    "test:http": "node scripts/http-smoke.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "5.22.0",
    "tsx": "^4.22.0",
    "typescript": "5.9.3"
  }
}
